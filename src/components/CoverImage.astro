---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cover: {
    square: ImageMetadata;
    standard: ImageMetadata;
    wide: ImageMetadata;
    alt: string;
  };
  sizes: string;
  eager?: boolean;
}

const { cover, sizes, eager = false } = Astro.props;
---

<!-- 網站上的封面一律用 4:3（2026-10-03 Ken 決定）；1:1、16:9 只交給 Google -->
<Image
  class="cover-img"
  src={cover.standard}
  alt={cover.alt}
  widths={[480, 800, 1280]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
/>

<style>
  .cover-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
