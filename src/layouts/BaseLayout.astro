---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
// 沒有封面的頁面（首頁、關於我們），分享預覽圖用寵物友善文章的封面
import defaultShareImage from '../assets/photos/pet-friendly-cover-16x9.jpg';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  // 分享到 LINE、Facebook 時的預覽圖，文章頁傳 16:9 封面進來
  shareImage?: ImageMetadata;
  shareImageAlt?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  keywords = [],
  shareImage = defaultShareImage,
  shareImageAlt = '白色馬爾濟斯開心待在高雄寵物友善民宿阿爾兔兔的門口',
  ogType = 'website',
} = Astro.props;
const ogImage = await getImage({ src: shareImage, width: Math.min(shareImage.width, 1200), format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site).toString();
const siteName = '阿爾兔兔民宿部落格';
const pageTitle = `${title}｜${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const officialSiteURL = 'https://ar2two.com';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 允許 Google 顯示大圖（Google Discover 的要求） -->
    <meta name="robots" content="max-image-preview:large" />
    <meta name="google-site-verification" content="tnd6yItyVmjfJRnIs7mRBq8trSrVWMkaiMSjs_OX-Eo" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- 字型：標題思源宋體、內文思源黑體（Google 會切片，只下載頁面用到的字） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    <!-- Open Graph（社群分享預覽用） -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} 阿爾兔兔民宿．<a href={officialSiteURL}>ar2two.com</a>．<a href="/about/">關於我們</a></p>
    </footer>

    <style>
      main {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }

      .site-footer {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 1.5rem;
        color: var(--muted);
        font-size: 0.85rem;
        border-top: 1px solid var(--border);
      }

      .site-footer a {
        color: var(--accent);
      }
    </style>
  </body>
</html>
