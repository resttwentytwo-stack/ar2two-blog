---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverImage from '../components/CoverImage.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 日期寫成「2026 年 8 月 24 日」（中文與數字之間加半形空格）
const formatDate = (date: Date) =>
  `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;

// 告訴 Google 網站名稱（搜尋結果網址上面那一行），只放在首頁
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '阿爾兔兔民宿部落格',
  url: 'https://blog.ar2two.com/',
};
---

<BaseLayout
  title="民宿主人的高雄住宿指南：帶毛小孩、多人出遊、看演唱會"
  description="阿爾兔兔民宿主人分享高雄住宿的實用經驗：帶毛小孩旅行、多人包棟、看演唱會，還有美麗島站周邊的交通。"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
  <h1>民宿主人的高雄住宿指南：帶毛小孩、多人出遊、看演唱會</h1>
  <p class="intro">我們是高雄的寵物友善包棟民宿阿爾兔兔，這裡分享帶毛小孩旅行、包棟住宿的實用經驗。</p>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="card">
          {post.data.cover && (
            <a class="card-cover" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
              <CoverImage cover={post.data.cover} sizes="(max-width: 780px) 100vw, 732px" />
            </a>
          )}
          <div class="card-body">
            <a class="card-title" href={`/blog/${post.id}/`}>
              {post.data.title}
              <span class="cta-hint">👉 點我查看細節</span>
            </a>
            <p class="meta">{formatDate(post.data.pubDate)}</p>
            <p class="excerpt">{post.data.description}</p>
          </div>
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p>目前還沒有文章，敬請期待。</p>}

  <style>
    .intro {
      color: var(--muted);
    }

    .post-list {
      list-style: none;
      padding: 0;
      margin: 2rem 0 0;
    }

    .card {
      margin-bottom: 1.75rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .card-cover {
      display: block;
    }

    .card-cover :global(.cover-img) {
      border-radius: 0;
    }

    .card-body {
      padding: 1rem 1.25rem 1.25rem;
    }

    .card-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
    }

    .card-title:hover {
      color: var(--accent);
    }

    .cta-hint {
      display: inline-block;
      margin-left: 0.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      white-space: nowrap;
    }

    .meta {
      color: var(--muted);
      font-size: 0.85rem;
      margin: 0.35rem 0;
    }

    .excerpt {
      margin: 0;
      color: var(--text);
    }
  </style>
</BaseLayout>
