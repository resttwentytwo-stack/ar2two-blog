---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverImage from '../../components/CoverImage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 文章目錄：只列大標題（h2），點了跳到該段。標題自己帶的「1.」先拿掉，統一用目錄的編號
const tocItems = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ ...h, text: h.text.replace(/^\d+[.、]\s*/, '') }));

// 日期寫成「2026 年 8 月 24 日」（中文與數字之間加半形空格）
const formatDate = (date: Date) =>
  `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();

// 封面三種比例的網址，只放進給 Google 看的資料，畫面上不顯示
const { cover } = post.data;
const coverURLs = cover
  ? await Promise.all(
      [cover.square, cover.standard, cover.wide].map(async (src) => {
        const img = await getImage({ src, format: 'jpg' });
        return new URL(img.src, Astro.site).toString();
      }),
    )
  : [];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: pageURL,
  ...(coverURLs.length > 0 && { image: coverURLs }),
  author: {
    '@type': 'Organization',
    name: '阿爾兔兔民宿',
    url: 'https://ar2two.com',
  },
  publisher: {
    '@type': 'Organization',
    name: '阿爾兔兔民宿',
    url: 'https://ar2two.com',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      發布於 <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <>
            ・最後更新 <time datetime={post.data.updatedDate.toISOString().slice(0, 10)}>{formatDate(post.data.updatedDate)}</time>
          </>
        )
      }
    </p>
    {cover && (
      <div class="article-cover">
        <CoverImage cover={cover} sizes="(max-width: 780px) 100vw, 732px" eager />
      </div>
    )}
    {
      tocItems.length > 1 && (
        <nav class="toc" aria-label="文章目錄">
          <p class="toc-title">文章目錄</p>
          <ol>
            {tocItems.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="content">
      <Content />
    </div>
  </article>

  <style>
    .meta {
      color: var(--muted);
      font-size: 0.85rem;
      margin: -0.5rem 0 1.5rem;
    }

    .article-cover {
      margin: 0 0 1.75rem;
    }

    .toc {
      margin: 0 0 2rem;
      padding: 1rem 1.25rem;
      background: var(--accent-soft);
      border-radius: var(--radius);
      font-size: 0.95rem;
    }

    .toc-title {
      margin: 0 0 0.6rem;
      font-weight: 700;
    }

    .toc ol {
      list-style: none;
      margin: 0;
      padding: 0;
      counter-reset: toc;
    }

    .toc li {
      counter-increment: toc;
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      padding: 0.3rem 0;
      line-height: 1.5;
    }

    .toc li + li {
      border-top: 1px dashed color-mix(in srgb, var(--muted) 30%, transparent);
    }

    /* 圓形編號徽章 */
    .toc li::before {
      content: counter(toc);
      flex: none;
      width: 1.5rem;
      height: 1.5rem;
      line-height: 1.5rem;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      text-align: center;
      transform: translateY(0.1rem);
    }

    .toc a {
      color: var(--text);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    /* 點目錄跳過去時，標題不要被固定的導覽列擋住 */
    .content :global(h2),
    .content :global(h3) {
      scroll-margin-top: 6rem;
    }

    .content :global(h2) {
      margin-top: 2rem;
    }

    .content :global(a) {
      color: var(--accent);
    }

    /* 表格：加框線、表頭底色、隔行底色 */
    .content :global(table) {
      width: 100%;
      margin: 1.5rem 0;
      border-collapse: collapse;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .content :global(th),
    .content :global(td) {
      padding: 0.6rem 0.8rem;
      border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
      text-align: left;
      vertical-align: top;
    }

    .content :global(th) {
      background: var(--accent-soft);
      font-weight: 700;
      white-space: nowrap;
    }

    .content :global(tbody tr:nth-child(even)) {
      background: color-mix(in srgb, var(--accent-soft) 40%, transparent);
    }

    /* 價格不要從中間斷行 */
    .content :global(td strong) {
      color: var(--accent-dark);
      white-space: nowrap;
    }

    @media (max-width: 480px) {
      /* 手機：格子內不自動換行；真的太寬時，表格自己左右滑動，不會撐破整頁 */
      .content :global(table) {
        display: block;
        overflow-x: auto;
        font-size: 0.8rem;
      }

      .content :global(th),
      .content :global(td) {
        padding: 0.45rem 0.4rem;
        white-space: nowrap;
      }
    }

    .content :global(img) {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto 0.5rem;
      border-radius: 8px;
    }

    .content :global(img + em) {
      display: block;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }
  </style>
</BaseLayout>
