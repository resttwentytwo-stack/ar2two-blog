---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 文章目錄：列出段落小標題（h2、h3），點了跳到該段
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 日期寫成「2026 年 8 月 24 日」（中文與數字之間加半形空格）
const formatDate = (date: Date) =>
  `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: pageURL,
  author: {
    '@type': 'Organization',
    name: '阿爾兔兔民宿',
    url: 'https://ar2two.com',
  },
  publisher: {
    '@type': 'Organization',
    name: '阿爾兔兔民宿',
    url: 'https://ar2two.com',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      發布於 <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <>
            ・最後更新 <time datetime={post.data.updatedDate.toISOString().slice(0, 10)}>{formatDate(post.data.updatedDate)}</time>
          </>
        )
      }
    </p>
    {
      tocItems.length > 1 && (
        <nav class="toc" aria-label="文章目錄">
          <p class="toc-title">文章目錄</p>
          <ol>
            {tocItems.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="content">
      <Content />
    </div>
  </article>

  <style>
    .meta {
      color: var(--muted);
      font-size: 0.85rem;
      margin: -0.5rem 0 1.5rem;
    }

    .toc {
      margin: 0 0 2rem;
      padding: 1rem 1.25rem;
      background: var(--accent-soft);
      border-radius: var(--radius);
      font-size: 0.95rem;
    }

    .toc-title {
      margin: 0 0 0.4rem;
      font-weight: 700;
    }

    .toc ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .toc li {
      padding: 0.15rem 0;
    }

    .toc li.depth-3 {
      padding-left: 1.25rem;
    }

    .toc a {
      color: var(--text);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    /* 點目錄跳過去時，標題不要被固定的導覽列擋住 */
    .content :global(h2),
    .content :global(h3) {
      scroll-margin-top: 6rem;
    }

    .content :global(h2) {
      margin-top: 2rem;
    }

    .content :global(a) {
      color: var(--accent);
    }

    .content :global(img) {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 1.5rem auto 0.5rem;
      border-radius: 8px;
    }

    .content :global(img + em) {
      display: block;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }
  </style>
</BaseLayout>
